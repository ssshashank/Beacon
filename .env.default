# Beacon Configuration (Zero-Config defaults)
# All variables are optional and have sensible defaults.

# Port the server listens on (default: 8000)
BEACON_PORT=8000

# Host interface to bind to (default: 0.0.0.0)
BEACON_HOST=0.0.0.0

# Path to the Docker daemon Unix socket (default: /var/run/docker.sock)
BEACON_DOCKER_SOCKET=/var/run/docker.sock

# Docker Engine API version (default: v1.51)
BEACON_DOCKER_API_VERSION=v1.51

# Static frontend assets directory (default: /app/dist/client in Docker, apps/web/dist/client locally)
BEACON_WEB_DIR=apps/web/dist/client

# Optional CORS origin for standalone dev server (leave empty for single-container production)
BEACON_CORS_ORIGIN=
